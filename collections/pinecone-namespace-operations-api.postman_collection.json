        {
          "id": "4c207685-dccd-461b-93c7-008c79492cda",
          "name": "List namespaces",
          "request": {
            "name": "List namespaces",
            "description": {
              "content": "List all namespaces in a serverless index.\n\nUp to 100 namespaces are returned at a time by default, in sorted order (bitwise “C” collation). If the `limit` parameter is set, up to that number of namespaces are returned instead. Whenever there are additional namespaces to return, the response also includes a `pagination_token` that you can use to get the next batch of namespaces. When the response does not include a `pagination_token`, there are no more namespaces to return.\n\nFor guidance and examples, see [Manage namespaces](https://docs.pinecone.io/guides/manage-data/manage-namespaces).\n\n**Note:** This operation is not supported for pod-based indexes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "namespaces"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Max number namespaces to return per page."
                },
                {
                  "disabled": false,
                  "key": "paginationToken",
                  "value": "<string>",
                  "description": "Pagination token to continue a previous listing operation."
                },
                {
                  "disabled": false,
                  "key": "prefix",
                  "value": "<string>",
                  "description": "Prefix of the namespaces to list. Acts as a filter to return only namespaces that start with this prefix."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Required date-based version header",
                "key": "X-Pinecone-Api-Version",
                "value": "2025-10"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "48690d6e-e91d-40eb-a35e-0c6d335abe1b",
              "name": "A successful response",
